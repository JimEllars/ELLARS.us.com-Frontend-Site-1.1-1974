+  const validateForm = () => {
+    const newErrors = {};
+    if (!title.trim()) newErrors.title = 'Brief Title is required.';
+    if (!body.trim()) newErrors.body = 'Intelligence Body Payload is required.';
+
+    // Explicitly enforce comma-separated format for tags
