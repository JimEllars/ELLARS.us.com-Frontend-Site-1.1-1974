+        app_id: 'ellars.us.com',
+        type: 'intel_brief',
+        title: title.trim(),
+        excerpt: excerpt.trim(),
+        tags: tags.split(',').map(tag => tag.trim()).filter(Boolean),
+        content: body.trim(),
+        created_at: new Date().toISOString()
