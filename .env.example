# ---------------------------------------------------------------------------
# ellars.us.com — environment reference
#
# There are two classes of value here and they are NOT interchangeable:
#
#  * VITE_*  — inlined into the browser bundle at BUILD time. Changing one
#              requires a rebuild + redeploy.
#  * bare    — read at RUNTIME by the Pages Functions in functions/ (via `env`),
#              so changing one is a dashboard edit, not a redeploy.
#
# The Supabase publishable ("anon") key must be bound as the bare
# SUPABASE_ANON_KEY in the Pages project. It is deliberately not committed: it
# ships to every visitor anyway, but committing it makes key rotation a code
# change. /api/config serves it to the client, and a deployment without it
# reports `configured: false` instead of failing with
# "UNAUTHORIZED_MISSING_API_KEY" on every login.
# ---------------------------------------------------------------------------

# --- build-time (browser) --------------------------------------------------
VITE_WP_API_URL=https://wp.ellars.us.com/wp-json/wp/v2
VITE_EMAILIT_HOST=smtp.emailit.com
VITE_SUPABASE_URL=https://pvbcdndqjguzqeafhwhw.supabase.co

# Optional fast path: if set at build time, the client uses it directly instead
# of calling /api/config. Prefer the runtime SUPABASE_ANON_KEY binding.
# VITE_SUPABASE_ANON_KEY=

VITE_CF_STREAM_LIVE_UID=
VITE_CF_FORM_ENDPOINT=
VITE_TURNSTILE_SITE_KEY=
VITE_DONATION_LINK=

# --- runtime (Pages Functions, bind in the Cloudflare dashboard) -----------
# Public Supabase project URL. Falls back to the default project if unset.
# SUPABASE_URL=https://pvbcdndqjguzqeafhwhw.supabase.co

# Publishable (anon) key. REQUIRED for login, /dashboard, the Vault and media
# upload. Must be the anon/public key — a service_role key is refused by
# /api/config because it bypasses Row-Level Security.
# SUPABASE_ANON_KEY=

# Optional overrides used by the edge functions
# WP_API_URL=https://wp.ellars.us.com/wp-json/wp/v2
