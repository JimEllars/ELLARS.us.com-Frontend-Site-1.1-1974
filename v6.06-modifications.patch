+        'Prefer': 'return=representation',
+        'X-Client-Telemetry': 'AXiM-Frontend-v1'
+      },
+      body: JSON.stringify(finalPayload)
+    });
+
+    if (!response.ok) {
+      console.error("[AXiM Core: Vault Error] Failed to update item", response.status);
