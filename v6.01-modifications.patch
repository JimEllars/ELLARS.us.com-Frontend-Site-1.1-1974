+import fs from 'fs';
+let content = fs.readFileSync('src/store/useAppStore.js', 'utf8');
+
+// Ensure setIsLiveStreamActive is present
+if (!content.includes('setIsLiveStreamActive:')) {
+  content = content.replace(
+    'setArticles: (articles) => set({ articles }),',
+    'setIsLiveStreamActive: (status) => set({ isLiveStreamActive: status }),\n      setArticles: (articles) => set({ articles }),'
+  );
+  fs.writeFileSync('src/store/useAppStore.js', content, 'utf8');
+}
