# Cloudflare Pages headers for ellars.us.com
#
# Notes for whoever edits this next:
# - connect-src was 'https:' which permits exfiltration to ANY https host and
#   therefore defeated the policy. Every host is now named explicitly.
# - media-src allow-listed https://www.w3schools.com (template residue) and has
#   been removed.
# - frame-src must list the video origins or the rich-media renderers in
#   ArticleDetail are blocked by the browser no matter what DOMPurify allows.
# - api.axim.us.com is permanently gone (Bluehost 404). Do not add it back.
# - script-src still carries 'unsafe-inline'. Moving to hashes/nonces is tracked
#   in PlanForContinuedDevelopment.md; it needs the Turnstile loader and the
#   Cloudflare Web Analytics beacon verified first.

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://wp.axim.us.com https://wp.ellars.us.com https://images.unsplash.com https://i.ytimg.com https://*.cloudflarestream.com; media-src 'self' blob: data: https://*.cloudflarestream.com https://play.pod.co; connect-src 'self' https://*.supabase.co https://wp.ellars.us.com https://wp.axim.us.com https://play.pod.co https://challenges.cloudflare.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://play.pod.co https://*.cloudflarestream.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/200.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.webm
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
