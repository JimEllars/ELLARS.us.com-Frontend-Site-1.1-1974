/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://api.axim.us.com https://wp.ellars.us.com wss://api.axim.us.com https://play.pod.co https://fonts.googleapis.com https://fonts.gstatic.com https://*.supabase.co; img-src 'self' data: https://wp.axim.us.com https://wp.ellars.us.com https://images.unsplash.com; media-src 'self' https://www.w3schools.com; frame-src 'self' https://challenges.cloudflare.com; object-src 'none';
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.webm
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store, no-cache, must-revalidate

/functions/*
  Cache-Control: no-store, no-cache, must-revalidate

/api/telemetry
  Cache-Control: no-store, no-cache, must-revalidate
